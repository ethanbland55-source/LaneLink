# Paste the Neon POOLED connection string here (the one from the
# "Connect to your database" dialog with Connection pooling ON).
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-snowy-mode-ab3ptsqv-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# The key session cookies are signed with. Without it the app falls back to a
# constant printed in lib/auth.ts, and anyone who reads that file can forge a
# cookie for any account. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Only used to create the very first account, on first page load. After that,
# accounts live in the database and passwords are changed from the Plan page.
# AUTH_USER="admin"
# AUTH_PASSWORD="1234"
