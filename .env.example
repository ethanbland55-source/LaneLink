# =============================================================================
# Carnforth Otters — environment variables
#
# Copy this file to `.env` for local development.
# In Vercel: Project → Settings → Environment Variables → add each of these to
# Production, Preview AND Development.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API Keys

# Project URL. Safe to expose — it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "Publishable" key (sb_publishable_…). Safe to expose: Row Level Security
# means it can read published content and nothing else.
# Older projects call this the "anon" key — NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# "Secret" key (sb_secret_…). SECRET — server-side only, never prefixed
# NEXT_PUBLIC_. This bypasses Row Level Security and is what the admin area
# writes with. Older projects call this "service_role" —
# SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Admin login --------------------------------------------------------------

# The single password that unlocks /admin. Choose something long.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately signs everyone out.
AUTH_SECRET=change-me-32-bytes-of-random-hex

# --- Site ---------------------------------------------------------------------

# Canonical URL, used for sitemap.xml, robots.txt and social share cards.
# On Vercel preview deploys you can leave this as the vercel.app URL.
NEXT_PUBLIC_SITE_URL=https://carnforthotters.co.uk
