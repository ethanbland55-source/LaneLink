# =============================================================================
# Carnforth Otters — environment variables
#
# Copy this file to `.env` for local development.
# In Vercel: Project → Settings → Environment Variables → add each of these to
# Production, Preview AND Development.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API

# Project URL. Safe to expose — it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon / public" key. Safe to expose. Read-only because of Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "service_role" key. SECRET — server-side only, never prefixed NEXT_PUBLIC_.
# This bypasses Row Level Security and is what the admin area writes with.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login --------------------------------------------------------------

# The single password that unlocks /admin. Choose something long.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately signs everyone out.
AUTH_SECRET=change-me-32-bytes-of-random-hex

# --- Site ---------------------------------------------------------------------

# Canonical URL, used for sitemap.xml, robots.txt and social share cards.
# On Vercel preview deploys you can leave this as the vercel.app URL.
NEXT_PUBLIC_SITE_URL=https://carnforthotters.co.uk
